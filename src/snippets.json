    {
     "start": 56,
     "lines": [
      "# 旁白即字幕，顺序和时间轴一一对应。",
      "CAPTIONS = [",
      "    \"一辆车倒挂在坡道上，为什么不会掉下来？\",",
      "    \"答案其实就在车底，那里装着一台风扇。\",",
      "    \"风扇周围围着一圈密封裙，把车底封起来。\","
     ]
    },
    {
     "start": 87,
     "lines": [
      "def _load_durations(count: int) -> list:",
      "    \"\"\"读同目录 durations.json；读不到就按句子长度估一个。\"\"\"",
      "    values = [len(CAPTIONS[i]) * 0.25 for i in range(count)]",
      "    try:",
      "        path = os.path.join(_HERE, \"durations.json\")",
      "        with open(path, \"r\", encoding=\"utf-8\") as handle:",
      "            data = json.load(handle)",
      "        loaded = [float(item) for item in data]",
      "    except Exception:",
      "        return values",
      "    for i in range(count):",
      "        if i < len(loaded):",
      "            values[i] = loaded[i]",
      "    return values",
      "",
      "",
      "DURATIONS = _load_durations(len(CAPTIONS))",
      "",
      "",
      "def slot(index: int) -> float:",
      "    \"\"\"第 index 句字幕的停留时间：配音时长 + 0.55 秒余量。\"\"\"",
      "    return DURATIONS[index] + 0.55"
     ]
    }
   ]
  },
  "how-timings": {
   "file": "07-roadster/scene_principle.py",
   "blocks": [
    {
     "start": 591,
     "lines": [
      "    def _write_timings(self) -> None:",
      "        \"\"\"把每句的起止时间写进同目录 timings.json；写不了也不能让渲染失败。\"\"\"",
      "        try:",
      "            rows = []",
      "            for i, text in enumerate(CAPTIONS):",
      "                if i >= len(self._starts):",
      "                    break",
      "                start = self._starts[i]",
      "                end = self._starts[i + 1] if i + 1 < len(self._starts) else self._now()",
      "                rows.append(",
      "                    {",
      "                        \"start\": round(float(start), 3),",
      "                        \"end\": round(float(end), 3),",
      "                        \"text\": text,",
      "                    }",
      "                )",
      "            path = os.path.join(_HERE, \"timings.json\")",
      "            with open(path, \"w\", encoding=\"utf-8\") as handle:",
      "                json.dump(rows, handle, ensure_ascii=False, indent=1)",
      "        except Exception:",
      "            pass"
     ]
    }
   ]
  },
