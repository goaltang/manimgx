  "matrix-transform": {
   "file": "01-matrix-transform/scene.py",
   "blocks": [
    {
     "start": 178,
     "lines": [
      "        # ------------------------------------------------------------ 变换步骤",
      "        def step(rows, text, geometric, run_time=4.0):",
      "            \"\"\"几何动画 + 矩阵更新同步播放。\"\"\"",
      "            target_matrix = m.MathTex(r\"M = \" + bmatrix(rows), font_size=46).move_to(matrix_mob)",
      "            target_caption = m.Text(text, font=font, font_size=26, color=m.YELLOW).move_to(caption)",
      "            self.play(",
      "                geometric,",
      "                m.Transform(matrix_mob, target_matrix),",
      "                m.Transform(caption, target_caption),",
      "                run_time=run_time,",
      "                rate_func=m.smooth,",
      "            )",
      "",
      "        # ① 旋转 30°：刚性旋转，网格保持正方形",
      "        step(",
      "            ROTATION,",
      "            \"① 旋转 30°\",",
      "            figure.animate.rotate(ROTATION_DEGREES * m.DEGREES, about_point=origin),",
      "        )",
      "        self.wait(0.5)",
      "",
      "        # ② 拉伸：沿 x 拉伸、沿 y 压缩，出现矩形格子",
      "        step(",
      "            matmul(STRETCH, ROTATION),",
      "            \"② 拉伸 (1.6, 0.6)\",",
      "            m.ApplyMatrix(STRETCH, figure, about_point=origin),",
      "        )",
      "        self.wait(0.5)",
      "",
      "        # ③ 剪切：竖线保持垂直，横线倾斜",
      "        step(",
      "            matmul(SHEAR, matmul(STRETCH, ROTATION)),",
      "            \"③ 剪切 (1, 0.9)\",",
      "            m.ApplyMatrix(SHEAR, figure, about_point=origin),",
      "        )",
      "        self.wait(0.5)"
     ]
    }
   ]
  },
