      "shots=json.load(open(P+'script.json'))['shots']",
      "def dur(f): return float(subprocess.check_output(['ffprobe','-v','error','-show_entries','format=duration','-of','csv=p=0',f]))",
      "res=[]",
      "for i,s in enumerate(shots):",
      "  f=W+f'vo{i}.wav'",
      "  if not os.path.exists(f):",
      "    body=json.dumps({'model':'qwen3-tts-flash','input':{'text':s['vo'],'voice':'Serena','language_type':'Chinese'}}).encode()",
      "    r=urllib.request.Request('https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation',body,{'Authorization':'Bearer '+key,'Content-Type':'application/json'})",
      "    u=json.load(urllib.request.urlopen(r,timeout=120))['output']['audio']['url']",
      "    urllib.request.urlretrieve(u,f)",
      "  d=dur(f); st=s['t0']+0.4; res.append((st,d,s))"
     ]
    }
   ]
