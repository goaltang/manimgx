  "how-font": {
   "file": "07-roadster/scene_principle.py",
   "blocks": [
    {
     "start": 111,
     "lines": [
      "def pick_cjk_font() -> str:",
      "    \"\"\"用 fontconfig 选一个系统里真实存在的中文字体，避免方块字。\"\"\"",
      "    try:",
      "        proc = subprocess.run(",
      "            [\"fc-list\", \":lang=zh\", \"family\"],",
      "            capture_output=True,",
      "            text=True,",
      "            timeout=5,",
      "        )",
      "        families: set[str] = set()",
      "        for line in proc.stdout.splitlines():",
      "            for name in line.split(\",\"):",
      "                families.add(name.strip())",
      "        for candidate in CJK_FONT_CANDIDATES:",
      "            if candidate in families:",
      "                return candidate",
      "    except Exception:",
      "        pass",
      "    return CJK_FONT_CANDIDATES[0]",
      "",
      "",
      "def chip(mob, opacity=0.92):",
      "    \"\"\"给标签垫一块深色底，避免被线条压住。\"\"\"",
      "    mob.add_background_rectangle(color=\"#10141c\", opacity=opacity, buff=0.06)",
      "    mob.set_z_index(8, family=True)",
      "    return mob",
      ""
     ]
    }
   ]
  },
